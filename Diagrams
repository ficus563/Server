stateDiagram-v2
    state "Соискатель" as Applicant {
        [*] --> FillResume : Начало
        FillResume : Заполнение резюме и профиля
        FillResume --> ApplyVacancy : Подача отклика на вакансию
    }

    state "Менеджер агентства" as Manager {
        ApplyVacancy --> CheckResume : Резюме получено
        CheckResume : Проверка резюме на соответствие
        state is_valid <<choice>>
        CheckResume --> is_valid
        
        is_valid --> RejectNotice : [Нет]
        is_valid --> SendToEmployer : [Да]
        
        RejectNotice : Отправить уведомление об отказе
        RejectNotice --> [*] : Конец
        
        SendToEmployer : Передать резюме работодателю
    }

    state "Работодатель" as Employer {
        SendToEmployer --> ReviewCandidate : Рассмотрение кандидатуры
        
        state is_approved <<choice>>
        ReviewCandidate --> is_approved
        
        is_approved --> RefuseCandidate : [Нет]
        is_approved --> ScheduleInterview : [Да]
        
        RefuseCandidate : Зафиксировать отказ
        RefuseCandidate --> RejectNotice
        
        ScheduleInterview : Назначить дату собеседования
        ScheduleInterview --> ConductInterview : Провести собеседование
        ConductInterview --> MakeOffer : Формирование оффера
    }

    MakeOffer --> CreateContract : Оффер принят
    state "Менеджер агентства" as Manager2 {
        CreateContract : Оформление договора и трудоустройства
        CreateContract --> [*] : Конец
    }

